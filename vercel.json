{
  "cleanUrls": true,
  "functions": {
    "api/chat.js": {
      "includeFiles": "chat-kb.json",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/guide-assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
